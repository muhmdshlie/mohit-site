# Copy this file to ".env" and fill in your own values.
# Never share .env or commit it to git.

# Port the website runs on (open http://localhost:3000)
PORT=3000

# Long random text used to sign login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# First admin login. Used ONLY the first time the server starts (when no admin exists yet).
# After the first start you can delete ADMIN_PASSWORD from this file.
# Password must be at least 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Your public web address, used for SEO links and sitemap.xml (no trailing slash).
# Leave empty while testing on your PC.
SITE_URL=

# Set to "production" when the site is live on HTTPS (makes login cookies HTTPS-only).
NODE_ENV=development

# Set to 1 if the site runs behind a proxy / hosting panel that handles HTTPS (e.g. Nginx, Render, Railway).
TRUST_PROXY=0
